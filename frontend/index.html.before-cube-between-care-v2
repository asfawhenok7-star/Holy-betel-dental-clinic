const aiButton =
  document.getElementById("aiButton");

const aiPanel =
  document.getElementById("aiPanel");

const aiClose =
  document.getElementById("aiClose");

const aiForm =
  document.getElementById("aiForm");

const aiInput =
  document.getElementById("aiInput");

const aiMessages =
  document.getElementById("aiMessages");


if(aiButton){

  aiButton.addEventListener(
    "click",
    function(){

      aiPanel.classList.toggle(
        "active"
      );

    }
  );

}


if(aiClose){

  aiClose.addEventListener(
    "click",
    function(){

      aiPanel.classList.remove(
        "active"
      );

    }
  );

}


function addAIMessage(text,type){

  const message =
    document.createElement("div");

  message.className =
    "ai-message " +
    (type || "");

  message.textContent =
    text;

  aiMessages.appendChild(
    message
  );

  aiMessages.scrollTop =
    aiMessages.scrollHeight;

}


if(aiForm){

  aiForm.addEventListener(
    "submit",
    async function(event){

      event.preventDefault();

      const message =
        aiInput.value.trim();

      if(!message){
        return;
      }

      addAIMessage(
        message,
        "user"
      );

      aiInput.value = "";


      try{

        const response =
          await fetch(
            "/api/assistant",
            {
              method:"POST",

              headers:{
                "Content-Type":
                  "application/json"
              },

              body:JSON.stringify({
                message:message
              })
            }
          );


        const data =
          await response.json();


        if(data && data.reply){

          addAIMessage(
            data.reply
          );

        }

        else if(data && data.message){

          addAIMessage(
            data.message
          );

        }

        else{

          addAIMessage(
            "I'm sorry, I couldn't process that right now. Please contact the clinic directly."
          );

        }

      }

      catch(error){

        addAIMessage(
          "I'm temporarily unavailable. Please contact Holy Betel Speciality Dental Clinic Center directly or book an appointment."
        );

      }

    }
  );

}


/* =========================================================
   HOLY BETEL — RELIABLE SCROLL ANIMATION ENGINE
========================================================= */

(function(){

  function initHolyBetelScroll(){

    const elements =
      document.querySelectorAll(
        ".bs-scroll-left, " +
        ".bs-scroll-right, " +
        ".bs-scroll-reveal, " +
        ".bs-scroll-image, " +
        ".bs-stagger, " +
        ".auto-scroll"
      );


    console.log(
      "Holy Betel scroll elements:",
      elements.length
    );


    if(!elements.length){
      return;
    }


    if("IntersectionObserver" in window){

      const observer =
        new IntersectionObserver(
          function(entries){

            entries.forEach(
              function(entry){

                if(entry.isIntersecting){

                  entry.target.classList.add(
                    "bs-scroll-visible"
                  );

                  observer.unobserve(
                    entry.target
                  );

                }

              }
            );

          },
          {
            threshold:0.08,
            rootMargin:
              "0px 0px -50px 0px"
          }
        );


      elements.forEach(
        function(element){

          const rect =
            element.getBoundingClientRect();

          if(
            rect.top < window.innerHeight &&
            rect.bottom > 0
          ){

            element.classList.add(
              "bs-scroll-visible"
            );

          }

          observer.observe(
            element
          );

        }
      );

    }

    else{

      elements.forEach(
        function(element){

          element.classList.add(
            "bs-scroll-visible"
          );

        }
      );

    }

  }


  if(
    document.readyState ===
    "loading"
  ){

    document.addEventListener(
      "DOMContentLoaded",
      initHolyBetelScroll
    );

  }

  else{

    initHolyBetelScroll();

  }

})();



/* HOLY BETEL - CORRECTED 3D DENTAL CUBE */

(function(){

  "use strict";

  const cube = document.getElementById("dentalCube");

  if(!cube){
    return;
  }

  let rotationX = -12;
  let rotationY = 0;

  let lastTime = performance.now();

  function animateCube(currentTime){

    const delta = currentTime - lastTime;
    lastTime = currentTime;

    rotationY += delta * 0.045;

    rotationX = -12 + Math.sin(currentTime * 0.001) * 10;

    cube.style.transform =
      "rotateX(" + rotationX + "deg) " +
      "rotateY(" + rotationY + "deg)";

    requestAnimationFrame(animateCube);
  }

  requestAnimationFrame(animateCube);

})();

