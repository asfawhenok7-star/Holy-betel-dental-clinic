/* =========================================================
   PREMIUM SCROLL ANIMATIONS
========================================================= */

.bs-scroll-reveal,
.bs-scroll-left,
.bs-scroll-right,
.bs-scroll-image,
.auto-scroll{
  opacity:0;
  will-change:opacity,transform;
}

.bs-scroll-reveal{
  transform:translateY(65px);
  transition:
    opacity .85s ease,
    transform .85s cubic-bezier(.22,1,.36,1);
}

.bs-scroll-left{
  transform:translateX(-100px);
  transition:
    opacity .95s ease,
    transform .95s cubic-bezier(.22,1,.36,1);
}

.bs-scroll-right{
  transform:translateX(100px);
  transition:
    opacity .95s ease,
    transform .95s cubic-bezier(.22,1,.36,1);
}

.bs-scroll-image{
  transform:translateX(110px) scale(.96);
  transition:
    opacity 1s ease,
    transform 1s cubic-bezier(.22,1,.36,1);
}

.bs-scroll-visible{
  opacity:1 !important;
  transform:translate3d(0,0,0) scale(1) !important;
}

.bs-stagger > *{
  opacity:0;
  transform:translateY(55px);
  transition:
    opacity .7s ease,
    transform .7s cubic-bezier(.22,1,.36,1);
}

.bs-stagger.bs-scroll-visible > *{
  opacity:1;
  transform:translateY(0);
}

.bs-stagger.bs-scroll-visible > *:nth-child(1){
  transition-delay:.05s;
}

.bs-stagger.bs-scroll-visible > *:nth-child(2){
  transition-delay:.12s;
}

.bs-stagger.bs-scroll-visible > *:nth-child(3){
  transition-delay:.19s;
}

.bs-stagger.bs-scroll-visible > *:nth-child(4){
  transition-delay:.26s;
}

.bs-stagger.bs-scroll-visible > *:nth-child(5){
  transition-delay:.33s;
}

.bs-stagger.bs-scroll-visible > *:nth-child(6){
  transition-delay:.40s;
}

.auto-scroll{
  transform:translateY(55px);
  transition:
    opacity .85s ease,
    transform .85s cubic-bezier(.22,1,.36,1);
}

.auto-scroll.bs-scroll-visible{
  opacity:1;
  transform:translateY(0);
}


/* =========================================================
   ACCESSIBILITY
