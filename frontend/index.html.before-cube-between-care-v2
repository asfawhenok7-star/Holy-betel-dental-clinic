<script>

/* =========================================================
   MOBILE NAVIGATION
========================================================= */

const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

if(menuBtn && navLinks){

  menuBtn.addEventListener("click",function(){

    navLinks.classList.toggle("active");

  });

  document.querySelectorAll(".nav a").forEach(function(link){

    link.addEventListener("click",function(){

      navLinks.classList.remove("active");

    });

  });

}


/* =========================================================
   CUSTOMER REVIEWS
========================================================= */

(function(){

  "use strict";

  const API_URL = "/api/reviews";

  const reviewForm =
    document.getElementById("reviewForm");

  const reviewName =
    document.getElementById("reviewName");

  const reviewText =
    document.getElementById("reviewText");

  const reviewRating =
    document.getElementById("reviewRating");

  const reviewSubmit =
    document.getElementById("reviewSubmit");

  const reviewMessage =
    document.getElementById("reviewMessage");

  const reviewsList =
    document.getElementById("reviewsList");

  const reviewsAverage =
    document.getElementById("reviewsAverage");

  const reviewsTotal =
    document.getElementById("reviewsTotal");

  const reviewsAverageStars =
    document.getElementById("reviewsAverageStars");

  const ratingMessage =
    document.getElementById("ratingMessage");

  const ratingStars =
    document.querySelectorAll(".rating-star");


  /* ============================================
     STAR SELECTION
  ============================================ */

  ratingStars.forEach(function(star){

    star.addEventListener("click",function(){

      const rating =
        Number(this.dataset.rating);

      reviewRating.value = rating;

      ratingStars.forEach(function(item){

        const itemRating =
          Number(item.dataset.rating);

        item.textContent =
          itemRating <= rating
            ? "★"
            : "☆";

        item.classList.toggle(
          "selected",
          itemRating <= rating
        );

      });

      ratingMessage.textContent =
        rating + " out of 5 stars selected.";

    });

  });


  /* ============================================
     LOAD APPROVED REVIEWS
  ============================================ */

  async function loadReviews(){

    try{

      const response =
        await fetch(API_URL);

      const data =
        await response.json();

      if(!data.success){

        throw new Error(
          data.message ||
          "Unable to load reviews."
        );

      }

      const summary =
        data.summary || {};

      const average =
        Number(summary.average_rating) || 0;

      const total =
        Number(summary.total_reviews) || 0;

      reviewsAverage.textContent =
        average.toFixed(1);

      reviewsTotal.textContent =
        total;

      const roundedAverage =
        Math.round(average);

      reviewsAverageStars.textContent =
        "★".repeat(roundedAverage) +
        "☆".repeat(5 - roundedAverage);

      renderReviews(
        data.reviews || []
      );

    }

    catch(error){

      console.error(
        "Review loading error:",
        error
      );

      reviewsList.innerHTML = `
        <div class="reviews-empty">
          <strong>
            Reviews are currently unavailable.
          </strong>

          <span>
            Please try again shortly.
          </span>
        </div>
      `;

    }

  }


  /* ============================================
     RENDER REVIEWS
  ============================================ */

  function renderReviews(reviews){

    if(!reviews.length){

      reviewsList.innerHTML = `
        <div class="reviews-empty">

          <div class="empty-stars">
            ☆☆☆☆☆
          </div>

          <strong>
            Be the first to share your experience.
          </strong>

          <span>
            Your review will appear here after approval.
          </span>

        </div>
      `;

      return;
    }


    reviewsList.innerHTML =
      reviews.map(function(review){

        const rating =
          Math.max(
            1,
            Math.min(
              5,
              Number(review.rating) || 1
            )
          );

        const stars =
          "★".repeat(rating) +
          "☆".repeat(5 - rating);

        const name =
          escapeHTML(
            review.name || "Customer"
          );

        const text =
          escapeHTML(
            review.review_text || ""
          );

        return `
          <article class="review">

            <div class="stars">
              ${stars}
            </div>

            <p>
              “${text}”
            </p>

            <strong>
              ${name}
            </strong>

          </article>
        `;

      }).join("");

  }


  /* ============================================
     SUBMIT REVIEW
  ============================================ */

  reviewForm.addEventListener(
    "submit",
    async function(event){

      event.preventDefault();

      const name =
        reviewName.value.trim();

      const text =
        reviewText.value.trim();

      const rating =
        Number(reviewRating.value);


      if(!name){

        showMessage(
          "Please enter your name.",
          "error"
        );

        reviewName.focus();

        return;
      }


      if(!rating || rating < 1 || rating > 5){

        showMessage(
          "Please select a rating from 1 to 5 stars.",
          "error"
        );

        return;
      }


      if(!text || text.length < 5){

        showMessage(
          "Please write at least 5 characters for your review.",
          "error"
        );

        reviewText.focus();

        return;
      }


      reviewSubmit.disabled = true;

      reviewSubmit.innerHTML =
        "<span>Submitting...</span>";

      clearMessage();


      try{

        const response =
          await fetch(
            API_URL,
            {
              method:"POST",

              headers:{
                "Content-Type":"application/json"
              },

              body:JSON.stringify({

                name:name,

                rating:rating,

                review_text:text

              })
            }
          );


        const data =
          await response.json();


        if(!response.ok || !data.success){

          throw new Error(
            data.message ||
            "Unable to submit review."
          );

        }


        reviewForm.reset();

        reviewRating.value = "";


        ratingStars.forEach(function(star){

          star.textContent = "☆";

          star.classList.remove(
            "selected"
          );

        });


        ratingMessage.textContent =
          "Tap a star to rate your experience.";


        showMessage(
          "Thank you! Your review has been submitted and is waiting for approval.",
          "success"
        );

      }

      catch(error){

        console.error(
          "Review submission error:",
          error
        );

        showMessage(
          error.message ||
          "Unable to submit your review. Please try again.",
          "error"
        );

      }

      finally{

        reviewSubmit.disabled = false;

        reviewSubmit.innerHTML =
          "<span>Submit Review</span>";

      }

    }
  );


  /* ============================================
     MESSAGE
  ============================================ */

  function showMessage(message,type){

    reviewMessage.textContent =
      message;

    reviewMessage.className =
      "review-message " + type;

  }


  function clearMessage(){

    reviewMessage.textContent = "";

    reviewMessage.className =
      "review-message";

  }


  /* ============================================
     HTML SAFETY
  ============================================ */

  function escapeHTML(value){

    return String(value)

      .replace(/&/g,"&amp;")

      .replace(/</g,"&lt;")

      .replace(/>/g,"&gt;")

      .replace(/"/g,"&quot;")

      .replace(/'/g,"&#039;");

  }


  /* ============================================
     START
  ============================================ */

  loadReviews();

})();


