<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="Holy Betel Speciality Dental Clinic Center - Professional family dental care, online appointments and AI assistance.">

<title>Holy Betel Speciality Dental Clinic Center | Professional Dental Care</title>

<style>
:root{
  --white:#ffffff;
  --soft:#f5fbfd;
  --soft-blue:#eaf7fb;
  --blue:#087ea5;
  --blue-dark:#075b78;
  --cyan:#12bfd3;
  --navy:#17465c;
  --text:#244f63;
  --muted:#678391;
  --line:#d8eaf0;
  --gold:#d6a84b;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--white);
  color:var(--text);
  overflow-x:hidden;
}

a{
  text-decoration:none;
  color:inherit;
}

button,
input,
textarea,
select{
  font:inherit;
}

img{
  max-width:100%;
  display:block;
}


/* =========================================================
   TOP BAR
========================================================= */

.topbar{
  background:var(--blue-dark);
  color:#fff;
  min-height:38px;
}

.topbar-inner{
  max-width:1240px;
  margin:auto;
  padding:0 5%;
  min-height:38px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  font-size:12px;
}

.topbar-left,
.topbar-right{
  display:flex;
  align-items:center;
  gap:20px;
}

.topbar a{
  color:#fff;
}

.topbar a:hover{
  text-decoration:underline;
}


/* =========================================================
   HEADER
========================================================= */

.header{
  position:sticky;
  top:0;
  z-index:1000;
  background:#fff;
  border-bottom:1px solid var(--line);
}

.header-inner{
  max-width:1240px;
  min-height:82px;
  margin:auto;
  padding:0 5%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
}

.logo{
  display:flex;
  align-items:center;
  gap:11px;
  white-space:nowrap;
}

.logo-mark{
  width:44px;
  height:44px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:var(--soft-blue);
  border:1px solid #cce8ef;
  color:var(--blue);
  font-size:22px;
  font-weight:900;
}

.logo-text{
  font-size:21px;
  font-weight:900;
  color:var(--navy);
  letter-spacing:-.5px;
}

.logo-text span{
  display:block;
  color:var(--cyan);
  font-size:11px;
  letter-spacing:.2px;
  margin-top:2px;
}

.nav{
  display:flex;
  align-items:center;
  gap:27px;
}

.nav a{
  color:#526f7c;
  font-size:14px;
  font-weight:700;
}

.nav a:hover{
  color:var(--blue);
}

.nav .appointment-link{
  color:#fff;
  background:var(--blue);
  padding:13px 21px;
  border-radius:5px;
}

.nav .appointment-link:hover{
  background:var(--blue-dark);
  color:#fff;
}

.menu-btn{
  display:none;
  border:0;
  background:transparent;
  color:var(--blue-dark);
  font-size:28px;
  cursor:pointer;
}


/* =========================================================
   HERO
========================================================= */

.hero{
  position:relative;
  min-height:650px;
  display:flex;
  align-items:center;
  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.98) 0%,
      rgba(255,255,255,.95) 38%,
      rgba(255,255,255,.65) 61%,
      rgba(255,255,255,.08) 100%
    ),
    url("https://images.unsplash.com/photo-1606811971618-4486d14f3f99?auto=format&fit=crop&w=2200&q=90")
    center/cover no-repeat;
}

.hero-inner{
  width:100%;
  max-width:1240px;
  margin:auto;
  padding:95px 5%;
}

.hero-content{
  max-width:610px;
}

.hero-label{
  display:inline-flex;
  align-items:center;
  gap:9px;
  color:var(--blue);
  font-size:12px;
  font-weight:900;
  letter-spacing:1.8px;
  margin-bottom:18px;
}

.hero-label::before{
  content:"";
  width:28px;
  height:2px;
  background:var(--cyan);
}

.hero h1{
  color:var(--navy);
  font-size:clamp(42px,5.5vw,72px);
  line-height:1.05;
  letter-spacing:-2.5px;
  margin-bottom:22px;
}

.hero h1 span{
  color:var(--blue);
}

.hero p{
  max-width:570px;
  color:#617986;
  font-size:17px;
  line-height:1.8;
  margin-bottom:29px;
}

.hero-actions{
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:13px;
}

.btn{
  min-height:48px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:13px 23px;
  border-radius:4px;
  font-size:13px;
  font-weight:900;
  border:1px solid transparent;
  transition:.2s ease;
}

.btn-primary{
  background:var(--blue);
  color:#fff;
}

.btn-primary:hover{
  background:var(--blue-dark);
  transform:translateY(-1px);
}

.btn-outline{
  border-color:#bddde6;
  background:#fff;
  color:var(--blue-dark);
}

.btn-outline:hover{
  border-color:var(--blue);
  color:var(--blue);
}


/* =========================================================
   TRUST STRIP
========================================================= */

.trust{
  background:#fff;
  border-bottom:1px solid var(--line);
}

.trust-inner{
  max-width:1240px;
  margin:auto;
  padding:0 5%;
  display:grid;
  grid-template-columns:repeat(4,1fr);
}

.trust-item{
  min-height:105px;
  padding:20px;
  display:flex;
  align-items:center;
  gap:13px;
  border-right:1px solid var(--line);
}

.trust-item:first-child{
  border-left:1px solid var(--line);
}

.trust-icon{
  width:43px;
  height:43px;
  flex:0 0 43px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:var(--soft-blue);
  color:var(--blue);
  font-weight:900;
  font-size:18px;
}

.trust-item strong{
  display:block;
  color:var(--navy);
  font-size:14px;
  margin-bottom:4px;
}

.trust-item span{
  color:var(--muted);
  font-size:12px;
  line-height:1.4;
}


/* =========================================================
   COMMON
========================================================= */

section{
  padding:90px 5%;
}

.section-inner{
  max-width:1240px;
  margin:auto;
}

.section-label{
  color:var(--blue);
  font-size:11px;
  font-weight:900;
  letter-spacing:1.8px;
  margin-bottom:13px;
}

.section-title{
  color:var(--navy);
  font-size:clamp(34px,4.5vw,52px);
  line-height:1.08;
  letter-spacing:-1.7px;
  margin-bottom:18px;
}

.section-text{
  color:var(--muted);
  line-height:1.8;
  max-width:680px;
}


/* =========================================================
   WELCOME
========================================================= */

.welcome{
  background:#fff;
}

.welcome-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:65px;
  align-items:center;
}

.welcome-image{
  min-height:500px;
  background:
    url("https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?auto=format&fit=crop&w=1500&q=90")
    center/cover no-repeat;
}

.welcome-content{
  max-width:570px;
}

.welcome-content h2{
  color:var(--navy);
  font-size:clamp(35px,4.3vw,53px);
  line-height:1.08;
  letter-spacing:-1.8px;
  margin-bottom:20px;
}

.welcome-content h2 span{
  color:var(--blue);
}

.welcome-content p{
  color:var(--muted);
  line-height:1.85;
  margin-bottom:19px;
}

.checks{
  margin-top:25px;
  display:grid;
  gap:13px;
}

.check{
  display:flex;
  align-items:center;
  gap:10px;
  color:#4f6e7c;
  font-size:14px;
  font-weight:700;
}

.check-mark{
  width:24px;
  height:24px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#e3f6fa;
  color:var(--blue);
  font-size:12px;
  font-weight:900;
}


/* =========================================================
   SERVICES
========================================================= */

.services{
  background:var(--soft);
}

.services-header{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:30px;
  margin-bottom:42px;
}

.services-header .section-text{
  max-width:560px;
}

.services-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.service{
  background:#fff;
  border:1px solid var(--line);
  transition:.2s ease;
}

.service:hover{
  border-color:#acd8e2;
  transform:translateY(-3px);
}

.service-image{
  height:215px;
  background-size:cover;
  background-position:center;
}

.service:nth-child(1) .service-image{
  background-image:url("https://images.unsplash.com/photo-1609840114035-3c981b782dfe?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(2) .service-image{
  background-image:url("https://images.unsplash.com/photo-1606811971618-4486d14f3f99?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(3) .service-image{
  background-image:url("https://images.unsplash.com/photo-1606265752439-1f18756aa2f4?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(4) .service-image{
  background-image:url("https://images.unsplash.com/photo-1550831107-1553da8c8464?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(5) .service-image{
  background-image:url("https://images.unsplash.com/photo-1600170311833-c2cf5280ce49?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(6) .service-image{
  background-image:url("https://images.unsplash.com/photo-1581585094787-82f1bda8f9c7?auto=format&fit=crop&w=1200&q=90");
}

.service-content{
  padding:23px;
}

.service-content h3{
  color:var(--navy);
  font-size:20px;
  margin-bottom:9px;
}

.service-content p{
  color:var(--muted);
  font-size:13px;
  line-height:1.7;
  margin-bottom:15px;
}

.service-link{
  color:var(--blue);
  font-size:12px;
  font-weight:900;
}


/* =========================================================
   FEATURE / TECHNOLOGY
========================================================= */

.care{
  background:#fff;
}

.care-grid{
  display:grid;
  grid-template-columns:.95fr 1.05fr;
  gap:60px;
  align-items:center;
}

.care-image{
  min-height:500px;
  background:
    url("https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1500&q=90")
    center/cover no-repeat;
}

.care-content h2{
  color:var(--navy);
  font-size:clamp(35px,4.5vw,54px);
  line-height:1.08;
  letter-spacing:-1.8px;
  margin-bottom:19px;
}

.care-content h2 span{
  color:var(--blue);
}

.care-content p{
  color:var(--muted);
  line-height:1.85;
  margin-bottom:27px;
}

.care-points{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:13px;
}

.care-point{
  padding:19px;
  border:1px solid var(--line);
  background:#f9fdfe;
}

.care-point strong{
  display:block;
  color:var(--navy);
  font-size:14px;
  margin-bottom:7px;
}

.care-point span{
  color:var(--muted);
  font-size:12px;
  line-height:1.6;
}


/* =========================================================
   DOCTORS
========================================================= */

.doctors{
  background:var(--soft);
}

.doctors-header{
  max-width:700px;
  margin-bottom:40px;
}

.doctors-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:25px;
}

.doctor{
  display:grid;
  grid-template-columns:230px 1fr;
  background:#fff;
  border:1px solid var(--line);
}

.doctor-photo{
  min-height:310px;
  background-size:cover;
  background-position:center top;
}

.doctor:nth-child(1) .doctor-photo{
  background-image:url("https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=900&q=90");
}

.doctor:nth-child(2) .doctor-photo{
  background-image:url("https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=900&q=90");
}

.doctor-info{
  padding:30px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.doctor-info .role{
  color:var(--blue);
  font-size:11px;
  font-weight:900;
  letter-spacing:1px;
  margin-bottom:9px;
}

.doctor-info h3{
  color:var(--navy);
  font-size:25px;
  margin-bottom:13px;
}

.doctor-info p{
  color:var(--muted);
  font-size:13px;
  line-height:1.7;
  margin-bottom:20px;
}

.doctor-link{
  color:var(--blue);
  font-size:12px;
  font-weight:900;
}


/* =========================================================
   CUSTOMER REVIEWS
========================================================= */

.reviews{
  background:#fff;
}

.reviews-header{
  text-align:center;
  margin-bottom:40px;
}

.reviews-header .section-text{
  margin:auto;
}

.reviews-summary{
  max-width:650px;
  margin:0 auto 38px;
  display:grid;
  grid-template-columns:1fr 1fr;
  border:1px solid var(--line);
  background:#fbfeff;
}

.rating-score,
.rating-count{
  min-height:125px;
  padding:25px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
}

.rating-score{
  border-right:1px solid var(--line);
}

.rating-score strong{
  color:var(--navy);
  font-size:38px;
  line-height:1;
  margin-bottom:9px;
}

.rating-score span,
.rating-count span{
  color:var(--muted);
  font-size:12px;
  margin-top:6px;
}

.rating-count strong{
  color:var(--navy);
  font-size:32px;
}

.rating-stars{
  color:var(--gold);
  font-size:18px;
  letter-spacing:3px;
}

.review-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.review{
  padding:28px;
  border:1px solid var(--line);
  background:#fbfeff;
  transition:.2s ease;
}

.review:hover{
  border-color:#acd8e2;
  transform:translateY(-3px);
}

.stars{
  color:var(--gold);
  letter-spacing:3px;
  font-size:14px;
  margin-bottom:18px;
}

.review p{
  color:#587582;
  font-size:14px;
  line-height:1.8;
  margin-bottom:22px;
}

.review strong{
  color:var(--navy);
  font-size:13px;
}

.reviews-loading,
.reviews-empty{
  grid-column:1 / -1;
  min-height:150px;
  padding:30px;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  text-align:center;
  border:1px solid var(--line);
  background:#fbfeff;
  color:var(--muted);
}

.reviews-empty strong{
  color:var(--navy);
  margin-bottom:8px;
}

.reviews-empty span{
  font-size:13px;
}

.empty-stars{
  color:var(--gold);
  font-size:25px;
  letter-spacing:4px;
  margin-bottom:12px;
}


/* =========================================================
   REVIEW FORM
========================================================= */

.review-form-card{
  max-width:780px;
  margin:55px auto 0;
  padding:38px;
  border:1px solid var(--line);
  background:linear-gradient(
    145deg,
    #ffffff,
    #f7fcfd
  );
}

.review-form-header{
  margin-bottom:28px;
}

.review-form-header h3{
  color:var(--navy);
  font-size:30px;
  margin-bottom:9px;
}

.review-form-header p{
  color:var(--muted);
  font-size:14px;
  line-height:1.7;
}

.form-group{
  margin-bottom:22px;
}

.form-group label{
  display:block;
  color:var(--navy);
  font-size:13px;
  font-weight:800;
  margin-bottom:9px;
}

.form-group input,
.form-group textarea{
  width:100%;
  border:1px solid #cfe3e9;
  background:#fff;
  color:var(--text);
  padding:13px 14px;
  outline:none;
  border-radius:3px;
  transition:.2s ease;
}

.form-group input:focus,
.form-group textarea:focus{
  border-color:var(--cyan);
  box-shadow:0 0 0 3px rgba(18,191,211,.08);
}

.form-group textarea{
  resize:vertical;
  min-height:125px;
  line-height:1.6;
}

.form-group small{
  display:block;
  margin-top:7px;
  color:var(--muted);
  font-size:11px;
}

.star-selector{
  display:flex;
  align-items:center;
  gap:3px;
}

.rating-star{
  width:38px;
  height:38px;
  padding:0;
  border:0;
  background:transparent;
  color:#b7cbd1;
  font-size:30px;
  line-height:1;
  cursor:pointer;
  transition:.15s ease;
}

.rating-star:hover,
.rating-star.selected{
  color:var(--gold);
  transform:scale(1.08);
}

.review-submit{
  min-height:50px;
  width:100%;
  border:0;
  border-radius:4px;
  background:var(--blue);
  color:#fff;
  font-size:13px;
  font-weight:900;
  cursor:pointer;
  transition:.2s ease;
}

.review-submit:hover{
  background:var(--blue-dark);
  transform:translateY(-1px);
}

.review-submit:disabled{
  opacity:.65;
  cursor:not-allowed;
  transform:none;
}

.review-message{
  min-height:20px;
  margin-top:16px;
  font-size:13px;
  line-height:1.6;
}

.review-message.success{
  color:#16724b;
}

.review-message.error{
  color:#b13a3a;
}


/* =========================================================
   NEW PATIENTS / PROCESS
========================================================= */

.process{
  background:var(--soft-blue);
}

.process-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:15px;
  margin-top:40px;
}

.process-card{
  background:#fff;
  border:1px solid var(--line);
  padding:26px;
}

.process-number{
  color:var(--blue);
  font-weight:900;
  font-size:12px;
  margin-bottom:22px;
}

.process-card h3{
  color:var(--navy);
  margin-bottom:10px;
  font-size:19px;
}

.process-card p{
  color:var(--muted);
  font-size:13px;
  line-height:1.7;
}


/* =========================================================
   APPOINTMENT CTA
========================================================= */

.appointment{
  background:
    linear-gradient(
      90deg,
      rgba(7,91,120,.94),
      rgba(7,126,165,.86)
    ),
    url("https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=2000&q=90")
    center/cover no-repeat;
  color:#fff;
}

.appointment-inner{
  max-width:900px;
  margin:auto;
  text-align:center;
}

.appointment .section-label{
  color:#b9f3f7;
}

.appointment h2{
  font-size:clamp(35px,5vw,56px);
  line-height:1.08;
  letter-spacing:-1.7px;
  margin-bottom:17px;
}

.appointment p{
  max-width:680px;
  margin:0 auto 27px;
  color:#e2f5f8;
  line-height:1.8;
}

.appointment .btn-primary{
  background:#fff;
  color:var(--blue-dark);
}

.appointment .btn-primary:hover{
  background:#effcff;
}


/* =========================================================
   FAQ
========================================================= */

.faq{
  background:#fff;
}

.faq-grid{
  max-width:900px;
  margin:40px auto 0;
  display:grid;
  gap:10px;
}

.faq-item{
  border:1px solid var(--line);
  background:#fff;
}

.faq-item summary{
  cursor:pointer;
  list-style:none;
  padding:19px 21px;
  color:var(--navy);
  font-weight:800;
  font-size:14px;
}

.faq-item summary::-webkit-details-marker{
  display:none;
}

.faq-item p{
  padding:0 21px 20px;
  color:var(--muted);
  line-height:1.75;
  font-size:13px;
}


/* =========================================================
   CONTACT
========================================================= */

.contact{
  background:var(--soft);
}

.contact-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
  margin-top:40px;
}

.contact-card{
  background:#fff;
  border:1px solid var(--line);
  padding:27px;
}

.contact-icon{
  width:44px;
  height:44px;
  display:grid;
  place-items:center;
  background:var(--soft-blue);
  color:var(--blue);
