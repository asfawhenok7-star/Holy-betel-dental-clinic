<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="BrightSmile Dental Clinic - Professional dental care, online appointments and AI assistance.">

<title>BrightSmile Dental Clinic</title>

<style>
:root{
  --white:#ffffff;
  --snow:#fbfeff;
  --ice:#f2fbfd;
  --ice2:#e8f8fc;
  --cyan:#16c9df;
  --cyan2:#7be9f2;
  --blue:#168fb8;
  --blue2:#247ca1;
  --text:#244f66;
  --muted:#668493;
  --line:#d7edf2;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--white);
  color:var(--text);
  overflow-x:hidden;
}

a{
  text-decoration:none;
  color:inherit;
}

button,input{
  font:inherit;
}

img{
  display:block;
  width:100%;
}

.navbar{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:1000;
  background:rgba(255,255,255,.97);
  border-bottom:1px solid var(--line);
}

.nav-inner{
  max-width:1280px;
  margin:auto;
  min-height:76px;
  padding:0 5%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
}

.logo{
  font-size:24px;
  font-weight:900;
  color:var(--text);
  white-space:nowrap;
}

.logo span{
  color:var(--cyan);
}

.nav-links{
  display:flex;
  align-items:center;
  gap:25px;
}

.nav-links a{
  color:#557789;
  font-size:14px;
  font-weight:700;
}

.nav-links a:hover{
  color:var(--cyan);
}

.nav-book{
  padding:12px 20px;
  border-radius:999px;
  background:var(--cyan2);
  color:#20556b!important;
}

.menu-btn{
  display:none;
  border:0;
  background:transparent;
  color:var(--blue);
  font-size:28px;
  cursor:pointer;
}

/* HERO */

.hero{
  min-height:100vh;
  padding:150px 5% 90px;
  display:flex;
  align-items:center;
  position:relative;
  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,.96) 0%,
      rgba(255,255,255,.84) 38%,
      rgba(255,255,255,.35) 72%,
      rgba(255,255,255,.08) 100%
    ),
    url("https://images.unsplash.com/photo-1606811971618-4486d14f3f99?auto=format&fit=crop&w=2200&q=90")
    center/cover no-repeat;
}

.hero-content{
  width:100%;
  max-width:1280px;
  margin:auto;
}

.hero-text{
  max-width:700px;
}

.kicker{
  display:inline-flex;
  align-items:center;
  gap:10px;
  margin-bottom:20px;
  color:#0faabd;
  font-size:12px;
  font-weight:900;
  letter-spacing:2px;
}

.kicker::before{
  content:"";
  width:35px;
  height:2px;
  background:var(--cyan);
}

.hero h1{
  color:var(--text);
  font-size:clamp(48px,7vw,86px);
  line-height:.98;
  letter-spacing:-4px;
  margin-bottom:25px;
}

.hero h1 span{
  color:var(--cyan);
  display:block;
}

.hero p{
  max-width:630px;
  color:#5d7887;
  font-size:18px;
  line-height:1.75;
  margin-bottom:32px;
}

.buttons{
  display:flex;
  gap:14px;
  flex-wrap:wrap;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:50px;
  padding:14px 25px;
  border-radius:999px;
  font-size:14px;
  font-weight:900;
  border:1px solid transparent;
}

.btn-primary{
  background:linear-gradient(135deg,#91eff5,#20cfe1);
  color:#22556a;
}

.btn-secondary{
  background:#fff;
  border-color:#cfe7ed;
  color:#4d7182;
}

/* INTRO */

.intro{
  padding:28px 5%;
  background:#fff;
  border-bottom:1px solid var(--line);
}

.intro-grid{
  max-width:1280px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.intro-card{
  padding:22px;
  background:#f5fcfe;
  border:1px solid #dceff3;
  border-radius:18px;
  display:flex;
  align-items:center;
  gap:15px;
}

.intro-icon{
  width:48px;
  height:48px;
  flex:0 0 48px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#d9f8fb;
  color:#129db4;
  font-size:22px;
}

.intro-card strong{
  display:block;
  color:var(--text);
  margin-bottom:4px;
}

.intro-card span{
  color:var(--muted);
  font-size:13px;
}

/* COMMON */

section{
  padding:100px 5%;
}

.section-inner{
  max-width:1280px;
  margin:auto;
}

.section-title{
  color:var(--text);
  font-size:clamp(36px,5vw,58px);
  line-height:1.05;
  letter-spacing:-2px;
  margin-bottom:18px;
}

.section-text{
  color:var(--muted);
  line-height:1.8;
  max-width:690px;
}

/* ABOUT */

.about{
  background:linear-gradient(180deg,#f8fdff,#ffffff);
}

.about-grid{
  display:grid;
  grid-template-columns:1.05fr .95fr;
  gap:55px;
  align-items:center;
}

.about-photo{
  min-height:570px;
  border-radius:32px;
  border:1px solid var(--line);
  background:
    url("https://images.unsplash.com/photo-1588776814546-1ffcf47267a5?auto=format&fit=crop&w=1600&q=90")
    center/cover no-repeat;
}

.about-content{
  padding:20px 0;
}

.about-content h2{
  color:var(--text);
  font-size:clamp(38px,5vw,62px);
  line-height:1.02;
  letter-spacing:-2px;
  margin-bottom:24px;
}

.about-content h2 span{
  color:var(--cyan);
}

.about-content p{
  color:var(--muted);
  line-height:1.85;
  font-size:16px;
  margin-bottom:25px;
}

.check-list{
  display:grid;
  gap:13px;
}

.check{
  display:flex;
  align-items:center;
  gap:12px;
  color:#527384;
  font-weight:700;
}

.check-icon{
  width:28px;
  height:28px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:#dff9fb;
  color:#13aec2;
  font-weight:900;
}

/* SERVICES */

.services{
  background:#eefafd;
}

.center-head{
  text-align:center;
  margin-bottom:50px;
}

.center-head .section-text{
  margin:auto;
}

.services-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:22px;
}

.service{
  overflow:hidden;
  background:#fff;
  border:1px solid var(--line);
  border-radius:25px;
}

.service-image{
  height:245px;
  background-size:cover;
  background-position:center;
}

.service:nth-child(1) .service-image{
  background-image:url("https://images.unsplash.com/photo-1745769423212-cbde4f91f2c7?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(2) .service-image{
  background-image:url("https://images.unsplash.com/photo-1677026010083-78ec7f1b84ed?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(3) .service-image{
  background-image:url("https://images.unsplash.com/photo-1771442873035-474765b40ac6?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(4) .service-image{
  background-image:url("https://images.unsplash.com/photo-1606811971618-4486d14f3f99?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(5) .service-image{
  background-image:url("https://images.unsplash.com/photo-1684607632599-748b1792a116?auto=format&fit=crop&w=1200&q=90");
}

.service:nth-child(6) .service-image{
  background-image:url("https://images.unsplash.com/photo-1758205308172-fc864545dcf7?auto=format&fit=crop&w=1400&q=90");
}

.service-content{
  padding:24px;
}

.service-content h3{
  color:var(--text);
  font-size:21px;
  margin-bottom:10px;
}

.service-content p{
  color:var(--muted);
  line-height:1.7;
  font-size:14px;
}

/* FEATURE */

.feature{
  background:#fff;
}

.feature-grid{
  display:grid;
  grid-template-columns:.9fr 1.1fr;
  gap:50px;
  align-items:center;
}

.feature-photo{
  min-height:520px;
  border-radius:32px;
  border:1px solid var(--line);
  background:
    url("https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=1600&q=90")
    center/cover no-repeat;
}

.feature-content h2{
  color:var(--text);
  font-size:clamp(38px,5vw,60px);
  line-height:1.04;
  letter-spacing:-2px;
  margin-bottom:22px;
}

.feature-content h2 span{
  color:var(--cyan);
}

.feature-content p{
  color:var(--muted);
  line-height:1.85;
  margin-bottom:28px;
}

.feature-points{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:15px;
}

.point{
  padding:20px;
  background:#f4fcfe;
  border:1px solid var(--line);
  border-radius:18px;
}

.point strong{
  display:block;
  color:var(--text);
  margin-bottom:6px;
}

.point span{
  color:var(--muted);
  font-size:13px;
  line-height:1.5;
}

/* DOCTORS */

.doctors{
  background:#f5fcfe;
}

.doctors-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:25px;
  margin-top:45px;
}

.doctor{
  overflow:hidden;
  background:#fff;
  border:1px solid var(--line);
  border-radius:28px;
}

.doctor-photo{
  height:410px;
  background-size:cover;
  background-position:center top;
}

.doctor:nth-child(1) .doctor-photo{
  background-image:url("https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=1100&q=90");
}

.doctor:nth-child(2) .doctor-photo{
  background-image:url("https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=1100&q=90");
}

.doctor-info{
  padding:25px;
}

.doctor-info h3{
  color:var(--text);
  font-size:24px;
  margin-bottom:7px;
}

.doctor-info p{
  color:#11aabd;
  font-weight:800;
  font-size:14px;
}

/* PROCESS */

.process{
  background:#fff;
}

.process-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
  margin-top:45px;
}

.process-card{
  padding:28px;
  background:#f5fcfe;
  border:1px solid var(--line);
  border-radius:22px;
}

.process-number{
  color:#13bfd3;
  font-size:14px;
  font-weight:900;
  margin-bottom:18px;
}

.process-card h3{
  color:var(--text);
  margin-bottom:10px;
}

.process-card p{
  color:var(--muted);
  font-size:14px;
  line-height:1.7;
}

/* BOOKING */

.booking{
  background:
    linear-gradient(
      90deg,
      rgba(246,253,255,.97),
      rgba(255,255,255,.86)
    ),
    url("https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=2000&q=90")
    center/cover no-repeat;
}

.booking-box{
  max-width:900px;
  margin:auto;
  padding:70px 45px;
  text-align:center;
  background:rgba(255,255,255,.96);
  border:1px solid var(--line);
  border-radius:32px;
}

.booking-box h2{
  color:var(--text);
  font-size:clamp(38px,5vw,60px);
  line-height:1.04;
  letter-spacing:-2px;
  margin-bottom:20px;
}

.booking-box p{
  max-width:650px;
  margin:0 auto 30px;
  color:var(--muted);
  line-height:1.8;
}

/* CONTACT */

.contact{
  background:#eefafd;
}

.contact-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
  margin-top:45px;
}

.contact-card{
  padding:30px;
  background:#fff;
  border:1px solid var(--line);
  border-radius:23px;
}

.contact-icon{
  width:50px;
  height:50px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#dff9fb;
  color:#11aabd;
  font-size:22px;
  margin-bottom:18px;
}

.contact-card h3{
  color:var(--text);
  margin-bottom:10px;
}

.contact-card p{
  color:var(--muted);
  line-height:1.7;
  font-size:14px;
}

/* AI */

.ai-button{
  position:fixed;
  right:25px;
  bottom:25px;
  z-index:2000;
  width:64px;
  height:64px;
  border:1px solid #bceef3;
  border-radius:50%;
  background:linear-gradient(135deg,#a1f2f6,#25d3e2);
  color:#24586d;
  font-size:25px;
  font-weight:900;
  cursor:pointer;
}

.ai-panel{
  position:fixed;
  right:25px;
  bottom:102px;
  z-index:1999;
  width:370px;
  max-width:calc(100vw - 30px);
  height:510px;
  display:none;
  flex-direction:column;
  overflow:hidden;
  background:#fff;
  border:1px solid var(--line);
  border-radius:25px;
}

.ai-panel.active{
  display:flex;
}

.ai-head{
  padding:19px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:#e9fafc;
  border-bottom:1px solid var(--line);
}

.ai-head strong{
  color:var(--text);
}

.ai-close{
  border:0;
  background:transparent;
  color:#568092;
  font-size:23px;
  cursor:pointer;
}

.ai-messages{
  flex:1;
  overflow-y:auto;
  padding:18px;
  background:#fbfeff;
}

.ai-message{
  max-width:85%;
  padding:12px 14px;
  margin-bottom:12px;
  border:1px solid #dceff3;
  border-radius:15px;
  background:#effafd;
  color:#507181;
  font-size:13px;
  line-height:1.6;
}

.ai-message.user{
  margin-left:auto;
  background:#d4f8fb;
  color:#28576b;
}

.ai-form{
  display:flex;
  gap:8px;
  padding:12px;
  background:#fff;
  border-top:1px solid var(--line);
}

.ai-form input{
  flex:1;
  min-width:0;
  padding:12px;
  border:1px solid #cfe7ed;
  border-radius:12px;
  outline:none;
  background:#f8fdfe;
  color:var(--text);
}

.ai-form input:focus{
  border-color:var(--cyan);
}

.ai-form button{
  border:0;
  border-radius:12px;
  padding:0 16px;
  background:#8ceef4;
  color:#28566a;
  font-weight:900;
  cursor:pointer;
}

/* FOOTER */

footer{
  padding:38px 5%;
  background:#e8f8fc;
  border-top:1px solid var(--line);
}

.footer-inner{
  max-width:1280px;
  margin:auto;
  display:flex;
  justify-content:space-between;
  gap:20px;
}

.footer-inner p{
  color:#6c8794;
  font-size:13px;
}

/* MOBILE */

@media(max-width:950px){

  .menu-btn{
    display:block;
  }

  .nav-links{
    position:absolute;
    top:76px;
    left:5%;
    right:5%;
    display:none;
    flex-direction:column;
    align-items:stretch;
    padding:20px;
    background:#fff;
    border:1px solid var(--line);
    border-radius:20px;
  }

  .nav-links.active{
    display:flex;
  }

  .nav-links a{
    padding:10px;
  }

  .hero{
    min-height:850px;
    padding-top:145px;
    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,.91),
        rgba(255,255,255,.67)
      ),
      url("https://images.unsplash.com/photo-1777331903190-341a3dd0441b?auto=format&fit=crop&w=2200&q=90")
      center/cover no-repeat;
  }

  .intro-grid{
    grid-template-columns:1fr;
  }

  .about-grid,
  .feature-grid{
    grid-template-columns:1fr;
  }

  .services-grid{
    grid-template-columns:1fr 1fr;
  }

  .process-grid{
    grid-template-columns:1fr 1fr;
  }

  .contact-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:650px){

  .nav-inner{
    min-height:68px;
  }

  .logo{
    font-size:21px;
  }

  .hero{
    min-height:790px;
    padding:130px 5% 70px;
  }

  .hero h1{
    font-size:clamp(44px,14vw,68px);
    letter-spacing:-3px;
  }

  .hero p{
    font-size:16px;
  }

  section{
    padding:75px 5%;
  }

  .about-photo,
  .feature-photo{
    min-height:350px;
  }

  .services-grid,
  .doctors-grid,
  .process-grid{
    grid-template-columns:1fr;
  }

  .doctor-photo{
    height:350px;
  }

  .feature-points{
    grid-template-columns:1fr;
  }

  .booking-box{
    padding:50px 25px;
  }

  .buttons{
    flex-direction:column;
  }

  .btn{
    width:100%;
  }

  .footer-inner{
    flex-direction:column;
    text-align:center;
  }

  .ai-panel{
    right:15px;
    bottom:95px;
    width:calc(100vw - 30px);
    height:470px;
  }

  .ai-button{
    right:15px;
    bottom:18px;
  }
}
</style>
</head>

<body>

<header class="navbar">
  <div class="nav-inner">

    <a href="#home" class="logo">
      Bright<span>Smile</span>
    </a>

    <button class="menu-btn" id="menuBtn" aria-label="Open menu">
      ☰
    </button>

    <nav class="nav-links" id="navLinks">
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#services">Services</a>
      <a href="#doctors">Doctors</a>
      <a href="#contact">Contact</a>
      <a href="booking.html" class="nav-book">Book Appointment</a>
    </nav>

  </div>
</header>

<section class="hero" id="home">
  <div class="hero-content">
    <div class="hero-text">

