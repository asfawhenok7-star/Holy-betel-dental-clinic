<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#06111f">
<meta name="description" content="BrightSmile Dental Clinic — premium dental care, experienced doctors, and easy online appointments.">
<title>BrightSmile Dental Clinic | Premium Dental Care</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">

<style>
:root{
  --navy:#06111f;
  --navy-2:#091a2d;
  --navy-3:#0d2238;
  --cyan:#18d7e8;
  --cyan-2:#68f4ff;
  --white:#ffffff;
  --text:#eaf7fb;
  --muted:#9bb3c2;
  --glass:rgba(255,255,255,.075);
  --glass-border:rgba(255,255,255,.13);
  --shadow:0 24px 70px rgba(0,0,0,.35);
  --radius:24px;
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
  overflow-x:hidden;
}

body{
  font-family:"DM Sans",sans-serif;
  background:var(--navy);
  color:var(--text);
  overflow-x:hidden;
  line-height:1.6;
}

body.no-scroll{
  overflow:hidden;
}

img{
  display:block;
  width:100%;
  max-width:100%;
}

a{
  color:inherit;
  text-decoration:none;
}

button,
input{
  font:inherit;
}

button{
  cursor:pointer;
}

.container{
  width:min(1180px,calc(100% - 40px));
  margin:auto;
}

/* =========================
   NAVBAR
========================= */

.navbar{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:1000;
  padding:18px 0;
  transition:.3s ease;
}

.navbar.scrolled{
  background:rgba(6,17,31,.86);
  backdrop-filter:blur(20px);
  -webkit-backdrop-filter:blur(20px);
  border-bottom:1px solid rgba(255,255,255,.08);
  padding:12px 0;
}

.nav-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:24px;
}

.logo{
  display:flex;
  align-items:center;
  gap:11px;
  font-family:"Manrope",sans-serif;
  font-weight:800;
  font-size:20px;
  white-space:nowrap;
}

.logo-mark{
  width:40px;
  height:40px;
  border-radius:13px;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg,var(--cyan),#1685a0);
  color:#03111c;
  font-weight:800;
  box-shadow:0 8px 28px rgba(24,215,232,.3);
}

.nav-links{
  display:flex;
  align-items:center;
  gap:30px;
}

.nav-links a{
  color:#d6e7ed;
  font-size:14px;
  font-weight:600;
  transition:.25s ease;
}

.nav-links a:hover{
  color:var(--cyan-2);
}

.nav-book{
  padding:11px 18px;
  border:1px solid rgba(104,244,255,.4);
  border-radius:13px;
  background:rgba(24,215,232,.1);
}

.menu-btn{
  display:none;
  width:44px;
  height:44px;
  border:1px solid var(--glass-border);
  border-radius:13px;
  background:var(--glass);
  color:white;
  font-size:23px;
  align-items:center;
  justify-content:center;
}

/* =========================
   HERO
========================= */

.hero{
  position:relative;
  min-height:780px;
  display:flex;
  align-items:center;
  overflow:hidden;
  isolation:isolate;

  background:
    linear-gradient(
      90deg,
      rgba(3,12,23,.68) 0%,
      rgba(3,12,23,.42) 38%,
      rgba(3,12,23,.12) 72%,
      rgba(3,12,23,.06) 100%
    ),
    url("https://images.unsplash.com/photo-1606811971618-4486d14f3f99?auto=format&fit=crop&w=2200&q=85")
    center/cover no-repeat;
}

.hero::before{
  content:"";
  position:absolute;
  inset:0;

  background:
    radial-gradient(
      circle at 78% 28%,
      rgba(24,215,232,.16),
      transparent 32%
    ),
    linear-gradient(
      180deg,
      rgba(6,17,31,.02) 0%,
      rgba(6,17,31,.06) 55%,
      rgba(6,17,31,.28) 100%
    );

  z-index:-1;
}

.hero-content{
  width:100%;
  padding-top:90px;
}

.hero-copy{
  max-width:720px;
}

.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:8px 13px;
  border:1px solid rgba(104,244,255,.25);
  background:rgba(24,215,232,.08);
  color:var(--cyan-2);
  border-radius:999px;
  font-size:12px;
  font-weight:700;
  letter-spacing:.5px;
  margin-bottom:22px;
}

.eyebrow-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--cyan);
  box-shadow:0 0 15px var(--cyan);
}

.hero h1{
  font-family:"Manrope",sans-serif;
  font-size:clamp(42px,6vw,76px);
  line-height:1.02;
  letter-spacing:-3px;
  margin-bottom:22px;
  text-shadow:0 8px 35px rgba(0,0,0,.25);
}

.hero h1 span{
  color:var(--cyan-2);
}

.hero-text{
  max-width:590px;
  color:#e0edf2;
  font-size:18px;
  line-height:1.75;
  margin-bottom:30px;
  text-shadow:0 3px 18px rgba(0,0,0,.3);
}

.hero-actions{
  display:flex;
  flex-wrap:wrap;
  gap:14px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:50px;
  padding:0 22px;
  border-radius:14px;
  border:1px solid transparent;
  font-weight:700;
  transition:.25s ease;
}

.btn-primary{
  color:#03121b;
  background:linear-gradient(135deg,var(--cyan-2),var(--cyan));
  box-shadow:0 12px 35px rgba(24,215,232,.2);
}

.btn-primary:hover{
  transform:translateY(-2px);
  box-shadow:0 17px 42px rgba(24,215,232,.3);
}

.btn-secondary{
  background:rgba(255,255,255,.09);
  border-color:rgba(255,255,255,.25);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
}

.btn-secondary:hover{
  background:rgba(255,255,255,.16);
}

.hero-mini{
  display:flex;
  flex-wrap:wrap;
  gap:18px;
  margin-top:30px;
  color:#e0edf2;
  font-size:13px;
  text-shadow:0 2px 12px rgba(0,0,0,.3);
}

.hero-mini span{
  display:flex;
  align-items:center;
  gap:7px;
}

.hero-mini strong{
  color:var(--cyan-2);
}

/* floating card */

.hero-card{
  position:absolute;
  right:6%;
  bottom:90px;
  width:280px;
  padding:22px;
  border-radius:24px;
  border:1px solid rgba(255,255,255,.2);
  background:rgba(7,22,38,.48);
  backdrop-filter:blur(22px);
  -webkit-backdrop-filter:blur(22px);
  box-shadow:var(--shadow);
}

.hero-card-top{
  display:flex;
  justify-content:space-between;
  gap:15px;
  align-items:center;
  margin-bottom:17px;
}

.hero-card-label{
  color:#b7cbd4;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:1px;
}

.hero-card h3{
  font-family:"Manrope",sans-serif;
  font-size:21px;
  margin-top:3px;
}

.hero-card-icon{
  width:43px;
  height:43px;
  border-radius:14px;
  display:grid;
  place-items:center;
  background:rgba(24,215,232,.13);
  color:var(--cyan-2);
}

.hero-card p{
  color:#c9d9df;
  font-size:13px;
  margin-bottom:17px;
}

.hero-card-line{
  height:1px;
  background:rgba(255,255,255,.12);
  margin-bottom:15px;
}

.hero-card-bottom{
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:12px;
}

.available{
  color:#77f3c3;
}

.hero-card a{
  color:var(--cyan-2);
  font-weight:700;
}

/* =========================
   SECTIONS
========================= */

section{
  position:relative;
}

.section{
  padding:105px 0;
}

.section-heading{
  max-width:650px;
  margin-bottom:48px;
}

.section-kicker{
  color:var(--cyan-2);
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:1.5px;
  font-weight:800;
  margin-bottom:10px;
}

.section-heading h2{
  font-family:"Manrope",sans-serif;
  font-size:clamp(32px,4vw,48px);
  line-height:1.12;
  letter-spacing:-1.8px;
  margin-bottom:15px;
}

.section-heading p{
  color:var(--muted);
}

/* =========================
   STATS
========================= */

.stats{
  margin-top:-1px;
  background:#081727;
  border-top:1px solid rgba(255,255,255,.05);
  border-bottom:1px solid rgba(255,255,255,.05);
}

.stats-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
}

.stat{
  padding:35px 20px;
  text-align:center;
  border-right:1px solid rgba(255,255,255,.07);
}

.stat:last-child{
  border-right:0;
}

.stat strong{
  display:block;
  font-family:"Manrope",sans-serif;
  font-size:34px;
  color:var(--cyan-2);
  margin-bottom:3px;
  min-height:52px;
  line-height:1.4;
  text-shadow:0 0 22px rgba(24,215,232,.15);
}

.stat span{
  color:#91a8b5;
  font-size:13px;
}

/* =========================
   SERVICES
========================= */

.services{
  background:
    radial-gradient(circle at 10% 20%,rgba(24,215,232,.07),transparent 30%),
    var(--navy);
}

.service-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.service-card{
  min-height:245px;
  padding:27px;
  border:1px solid var(--glass-border);
  border-radius:var(--radius);
  background:linear-gradient(145deg,rgba(255,255,255,.07),rgba(255,255,255,.025));
  backdrop-filter:blur(15px);
  -webkit-backdrop-filter:blur(15px);
  transition:.3s ease;
}

.service-card:hover{
  transform:translateY(-6px);
  border-color:rgba(104,244,255,.3);
  box-shadow:0 20px 50px rgba(0,0,0,.2);
}

.service-icon{
  width:52px;
  height:52px;
  border-radius:16px;
  display:grid;
  place-items:center;
  background:rgba(24,215,232,.1);
  color:var(--cyan-2);
  font-size:23px;
  margin-bottom:20px;
}

.service-card h3{
  font-family:"Manrope",sans-serif;
  font-size:20px;
  margin-bottom:9px;
}

.service-card p{
  color:#91aab8;
  font-size:14px;
}

/* =========================
   PREMIUM SERVICE BACKGROUNDS
========================= */

.service-card{
  position:relative;
  overflow:hidden;
  min-height:300px;

  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;

  display:flex;
  flex-direction:column;
  justify-content:flex-end;

  border:1px solid rgba(255,255,255,.14);

  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.03),
    0 18px 45px rgba(0,0,0,.18);
}

/* Cinematic dark overlay */
.service-card::before{
  content:"";
  position:absolute;
  inset:0;

  background:
    linear-gradient(
      180deg,
      rgba(3,12,23,.10) 0%,
      rgba(3,12,23,.32) 42%,
      rgba(3,12,23,.88) 100%
    );

  z-index:0;
  transition:.35s ease;
}

/* Slight premium image zoom */
.service-card:hover{
  transform:translateY(-7px);
  border-color:rgba(104,244,255,.38);
  box-shadow:
    0 25px 60px rgba(0,0,0,.32),
    0 0 25px rgba(24,215,232,.08);
}

.service-card:hover::before{
  background:
    linear-gradient(
      180deg,
      rgba(3,12,23,.08) 0%,
      rgba(3,12,23,.28) 42%,
      rgba(3,12,23,.84) 100%
    );
}

.service-card > *{
  position:relative;
  z-index:1;
}

/* General Dentistry */
.service-card:nth-child(1){
  background-image:
    url("https://images.unsplash.com/photo-1745769423212-cbde4f91f2c7?auto=format&fit=crop&w=1200&q=85");
  background-position:center;
}

/* Teeth Whitening */
.service-card:nth-child(2){
  background-image:
    url("https://images.unsplash.com/photo-1677026010083-78ec7f1b84ed?auto=format&fit=crop&w=1200&q=85");
  background-position:center;
}

/* Dental Implants */
.service-card:nth-child(3){
  background-image:
    url("https://images.unsplash.com/photo-1771442873035-474765b40ac6?auto=format&fit=crop&w=1200&q=85");
  background-position:center;
}

/* Gum Care */
.service-card:nth-child(4){
  background-image:
    url("https://images.unsplash.com/photo-1606811971618-4486d14f3f99?auto=format&fit=crop&w=1200&q=85");
  background-position:center;
}

/* Cosmetic Dentistry */
.service-card:nth-child(5){
  background-image:
    url("https://images.unsplash.com/photo-1684607632599-748b1792a116?auto=format&fit=crop&w=1200&q=85");
  background-position:center;
}

/* Family Dentistry */
.service-card:nth-child(6){
  background-image:
    url("https://images.unsplash.com/photo-1758205308172-fc864545dcf7?auto=format&fit=crop&w=1400&q=85");
  background-position:center;
}

/* Service icon becomes a glass element */
.service-icon{
  width:52px;
  height:52px;
  border-radius:16px;

  display:grid;
  place-items:center;

  background:rgba(6,17,31,.58);
  border:1px solid rgba(104,244,255,.24);

  color:var(--cyan-2);
  font-size:23px;

  margin-bottom:18px;

  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);

  box-shadow:
    0 8px 25px rgba(0,0,0,.22);
}

/* Service title */
.service-card h3{
  font-family:"Manrope",sans-serif;
  font-size:21px;
  margin-bottom:8px;

  color:#ffffff;

  text-shadow:
    0 3px 15px rgba(0,0,0,.45);
}

/* Service description */
.service-card p{
  color:#e2edf1;
  font-size:14px;
  line-height:1.6;

  max-width:95%;

  text-shadow:
    0 2px 10px rgba(0,0,0,.55);
}

/* Mobile service cards */
@media(max-width:600px){

  .service-card{
    min-height:310px;
    padding:23px;
  }

  .service-card h3{
    font-size:20px;
  }

  .service-card p{
    font-size:13px;
  }

}/* =========================
   ABOUT
========================= */

.about{
  background:#081727;
}

.about-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:60px;
  align-items:center;
}

.about-image{
  position:relative;
  min-height:510px;
  border-radius:30px;
  overflow:hidden;
  border:1px solid rgba(255,255,255,.1);

  background:
    url("https://images.unsplash.com/photo-1606265752439-1f18756aa2a2?auto=format&fit=crop&w=1200&q=85")
    center/cover no-repeat;

  box-shadow:var(--shadow);
}

.about-image::after{
  content:"";
  position:absolute;
  inset:0;

  background:
    linear-gradient(
      180deg,
      transparent 45%,
      rgba(3,12,23,.08) 65%,
      rgba(3,12,23,.38) 100%
    );
}

.about-badge{
  position:absolute;
  left:22px;
  bottom:22px;
  z-index:1;
  padding:18px 20px;
  border-radius:18px;
  border:1px solid rgba(255,255,255,.18);
  background:rgba(6,17,31,.52);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
}

.about-badge strong{
  display:block;
  font-family:"Manrope",sans-serif;
  font-size:25px;
  color:var(--cyan-2);
}

.about-badge span{
  font-size:12px;
  color:#d2e0e5;
}

.about-copy h2{
  font-family:"Manrope",sans-serif;
  font-size:clamp(32px,4vw,48px);
  line-height:1.12;
  letter-spacing:-1.8px;
  margin-bottom:20px;
}

.about-copy > p{
  color:#9db2be;
  line-height:1.8;
  margin-bottom:25px;
}

.about-list{
  display:grid;
  gap:14px;
}

.about-list div{
  display:flex;
  gap:12px;
  align-items:flex-start;
  color:#c9d8df;
  font-size:14px;
}

.check{
  flex:0 0 25px;
  width:25px;
  height:25px;
  border-radius:8px;
  display:grid;
  place-items:center;
  background:rgba(24,215,232,.1);
  color:var(--cyan-2);
  font-size:12px;
}

/* =========================
   DOCTORS
========================= */

.doctors{
  background:var(--navy);
}

.doctor-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:20px;
  max-width:900px;
}

.doctor-card{
  display:grid;
  grid-template-columns:190px 1fr;
  min-height:280px;
  overflow:hidden;
  border:1px solid var(--glass-border);
  border-radius:var(--radius);
  background:rgba(255,255,255,.045);
}

.doctor-image{
  background-size:cover;
  background-position:center;
}

.doctor-one{
  background-image:url("https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=700&q=85");
}

.doctor-two{
  background-image:url("https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=700&q=85");
}

.doctor-info{
  padding:27px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.doctor-info small{
  color:var(--cyan-2);
  font-weight:700;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:1px;
}

.doctor-info h3{
  font-family:"Manrope",sans-serif;
  font-size:23px;
  margin:6px 0 8px;
}

.doctor-info p{
  color:#91aab8;
  font-size:14px;
}

/* =========================
   BOOKING CTA
========================= */

.booking-cta{
  padding:100px 0;

  background:
    linear-gradient(
      90deg,
      rgba(4,16,28,.70),
      rgba(4,16,28,.42)
    ),
    url("https://images.unsplash.com/photo-1629909613654-28e377c37b09?auto=format&fit=crop&w=2000&q=85")
    center/cover no-repeat;
}

.booking-box{
  padding:55px;
  border-radius:30px;
  border:1px solid rgba(104,244,255,.2);
  background:rgba(6,17,31,.42);
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  text-align:center;
  box-shadow:var(--shadow);
}

.booking-box h2{
  font-family:"Manrope",sans-serif;
  font-size:clamp(32px,4vw,51px);
  line-height:1.1;
  margin-bottom:15px;
}

.booking-box p{
  max-width:600px;
  margin:0 auto 25px;
  color:#c6d7de;
}

/* =========================
   FAQ
========================= */

.faq{
  background:#081727;
}

.faq-list{
  max-width:850px;
  display:grid;
  gap:12px;
}

.faq-item{
  border:1px solid rgba(255,255,255,.09);
  border-radius:18px;
  background:rgba(255,255,255,.035);
  overflow:hidden;
}

.faq-question{
  width:100%;
  padding:21px 22px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  border:0;
  background:transparent;
  color:white;
  text-align:left;
  font-weight:700;
}

.faq-plus{
  color:var(--cyan-2);
  font-size:23px;
  flex:0 0 auto;
  transition:.25s ease;
}

.faq-answer{
  display:none;
  padding:0 22px 21px;
  color:#94aab6;
  font-size:14px;
}

.faq-item.open .faq-answer{
  display:block;
}

.faq-item.open .faq-plus{
  transform:rotate(45deg);
}

/* =========================
   CONTACT
========================= */

.contact{
  background:var(--navy);
}

.contact-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.contact-card{
  padding:27px;
  border:1px solid var(--glass-border);
  border-radius:22px;
  background:rgba(255,255,255,.045);
}

.contact-card-icon{
  width:45px;
  height:45px;
  display:grid;
  place-items:center;
  border-radius:14px;
  background:rgba(24,215,232,.1);
  color:var(--cyan-2);
  margin-bottom:17px;
}

.contact-card h3{
  margin-bottom:7px;
  font-family:"Manrope",sans-serif;
}

.contact-card p{
  color:#91aab8;
  font-size:14px;
}

.contact-card a{
