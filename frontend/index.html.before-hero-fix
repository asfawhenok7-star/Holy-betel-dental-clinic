/* ==========================================
   NAVBAR
========================================== */

const navbar = document.getElementById("navbar");

window.addEventListener("scroll", () => {
  if(window.scrollY > 20){
    navbar.classList.add("scrolled");
  }else{
    navbar.classList.remove("scrolled");
  }
});


/* ==========================================
   MOBILE MENU
========================================== */

const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

menuBtn.addEventListener("click", () => {
  navLinks.classList.toggle("open");
});

document.querySelectorAll(".nav-links a").forEach(link => {
  link.addEventListener("click", () => {
    navLinks.classList.remove("open");
  });
});


/* ==========================================
   FAQ
========================================== */

document.querySelectorAll(".faq-question").forEach(button => {

  button.addEventListener("click", () => {

    const item = button.parentElement;

    document.querySelectorAll(".faq-item").forEach(other => {
      if(other !== item){
        other.classList.remove("open");
      }
    });

    item.classList.toggle("open");

  });

});


/* ==========================================
   PREMIUM STAT COUNTERS
========================================== */

const counters = document.querySelectorAll(".counter");
const statsSection = document.querySelector(".stats");

function animateCounter(counter){

  const target = Number(counter.dataset.target);
  const finalDisplay = counter.dataset.display || target.toString();

  const duration = 1800;
  const startTime = performance.now();

  function updateCounter(currentTime){

    const elapsed = currentTime - startTime;

    const progress = Math.min(
      elapsed / duration,
      1
    );

    /* Smooth ease-out animation */
    const easedProgress =
      1 - Math.pow(1 - progress, 3);

    const currentValue =
      Math.floor(target * easedProgress);

    if(target >= 1000){

      counter.textContent =
        currentValue.toLocaleString();

    }else{

      counter.textContent =
        currentValue;

    }

    if(progress < 1){

      requestAnimationFrame(updateCounter);

    }else{

      counter.textContent = finalDisplay;

    }

  }

  requestAnimationFrame(updateCounter);
}


/* Start counting when statistics enter the screen */

if(statsSection && counters.length){

  const statsObserver =
    new IntersectionObserver(
      (entries, observer) => {

        entries.forEach(entry => {

          if(entry.isIntersecting){

            counters.forEach((counter, index) => {

              setTimeout(() => {

                animateCounter(counter);

              }, index * 180);

            });

            observer.unobserve(statsSection);

          }

        });

      },
      {
        threshold:0.35
      }
    );

  statsObserver.observe(statsSection);
}


/* ==========================================
   AI ASSISTANT
========================================== */

const bsAiButton =
  document.getElementById("bsAiButton");

const bsAiPanel =
  document.getElementById("bsAiPanel");

const bsAiClose =
  document.getElementById("bsAiClose");

const bsAiInput =
  document.getElementById("bsAiInput");

const bsAiSend =
  document.getElementById("bsAiSend");

const bsAiMessages =
  document.getElementById("bsAiMessages");


bsAiButton.addEventListener("click", () => {

  bsAiPanel.classList.toggle("open");

  if(bsAiPanel.classList.contains("open")){
    bsAiInput.focus();
  }

});


bsAiClose.addEventListener("click", () => {

  bsAiPanel.classList.remove("open");

});


function addAiMessage(text,type){

  const message =
    document.createElement("div");

  message.className =
    "bs-ai-message " + type;

  message.textContent = text;

  bsAiMessages.appendChild(message);

  bsAiMessages.scrollTop =
    bsAiMessages.scrollHeight;
}


function getAiReply(message){

  const text =
    message.toLowerCase();


  if(
    text.includes("book") ||
    text.includes("appointment") ||
    text.includes("schedule")
  ){

    return "Absolutely! You can book an appointment online by choosing your service, doctor and preferred time.";

  }


  if(
    text.includes("service") ||
    text.includes("treatment")
  ){

    return "We offer General Dentistry, Teeth Whitening, Dental Implants, Gum Care, Cosmetic Dentistry and Family Dentistry.";

  }


  if(
    text.includes("doctor") ||
    text.includes("dentist")
  ){

    return "Our dental team currently includes Dr. Sarah for General Dentistry and Dr. Michael for Cosmetic & Restorative Dentistry.";

  }


  if(
    text.includes("price") ||
    text.includes("cost")
  ){

    return "Our services have different prices. Please use the booking page to see the available service information.";

  }


  if(
    text.includes("hello") ||
    text.includes("hi") ||
    text.includes("hey")
  ){

    return "Hello! 👋 How can I help you with your dental appointment today?";

  }


  return "I can help with appointments, dental services, doctors and general clinic information. What would you like to know?";

}


function sendAiMessage(){

  const message =
    bsAiInput.value.trim();

  if(!message) return;

  addAiMessage(
    message,
    "user"
  );

  bsAiInput.value = "";


  setTimeout(() => {

    addAiMessage(
      getAiReply(message),
      "bot"
    );

  },400);

}


bsAiSend.addEventListener(
  "click",
  sendAiMessage
);


bsAiInput.addEventListener(
  "keydown",
  (event) => {

    if(event.key === "Enter"){
      sendAiMessage();
    }

  }
);

