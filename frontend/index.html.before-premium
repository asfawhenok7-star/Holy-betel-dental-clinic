<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BrightSmile Dental Clinic | Modern Dental Care</title>

    <meta
        name="description"
        content="BrightSmile Dental Clinic provides modern, comfortable dental care with convenient online appointment booking."
    >

    <style>
        /* =========================================================
           BRIGHTSMILE DENTAL CLINIC
           PREMIUM LANDING PAGE
        ========================================================= */

        :root {
            --primary: #0f766e;
            --primary-dark: #115e59;
            --primary-light: #ccfbf1;
            --cyan: #06b6d4;
            --navy: #0f172a;
            --text: #334155;
            --muted: #64748b;
            --light: #f8fafc;
            --white: #ffffff;
            --border: #e2e8f0;
            --shadow: 0 20px 60px rgba(15, 23, 42, 0.09);
            --radius: 22px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Arial,
                sans-serif;

            background: var(--light);
            color: var(--navy);
            line-height: 1.6;
            overflow-x: hidden;
        }

        body::selection {
            background: var(--primary);
            color: white;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input,
        textarea,
        select {
            font: inherit;
        }

        img {
            max-width: 100%;
        }

        .container {
            width: min(1180px, calc(100% - 40px));
            margin: 0 auto;
        }

        /* =========================================================
           ANNOUNCEMENT BAR
        ========================================================= */

        .announcement {
            background: var(--navy);
            color: white;
            text-align: center;
            padding: 9px 20px;
            font-size: 13px;
        }

        .announcement span {
            color: #99f6e4;
            font-weight: 800;
        }

        /* =========================================================
           NAVIGATION
        ========================================================= */

        .navbar {
            position: sticky;
            top: 0;
            z-index: 1000;

            background: rgba(255, 255, 255, 0.90);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
        }

        .nav-inner {
            min-height: 76px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 11px;
            flex-shrink: 0;
        }

        .logo-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;

            display: grid;
            place-items: center;

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    #14b8a6
                );

            color: white;
            font-size: 22px;

            box-shadow:
                0 8px 20px rgba(15, 118, 110, 0.22);
        }

        .logo-text strong {
            display: block;
            font-size: 18px;
            line-height: 1.1;
            letter-spacing: -0.4px;
        }

        .logo-text small {
            display: block;
            margin-top: 3px;
            color: var(--muted);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.4px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 28px;
        }

        .nav-links > a:not(.nav-cta) {
            color: #475569;
            font-size: 14px;
            font-weight: 700;
            transition: 0.2s;
        }

        .nav-links > a:not(.nav-cta):hover {
            color: var(--primary);
        }

        .nav-cta {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            padding: 12px 19px;
            border-radius: 12px;

            background: var(--primary);
            color: white;

            font-size: 14px;
            font-weight: 800;

            box-shadow:
                0 8px 22px rgba(15, 118, 110, 0.18);

            transition: 0.2s;
        }

        .nav-cta:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .mobile-menu {
            display: none;

            width: 44px;
            height: 44px;

            border: 1px solid var(--border);
            border-radius: 12px;

            background: white;
            color: var(--navy);

            cursor: pointer;
            font-size: 23px;
        }

        /* =========================================================
           HERO
        ========================================================= */

        .hero {
            position: relative;
            overflow: hidden;

            background:
                radial-gradient(
                    circle at 10% 10%,
                    rgba(20, 184, 166, 0.12),
                    transparent 32%
                ),
                radial-gradient(
                    circle at 90% 30%,
                    rgba(6, 182, 212, 0.12),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #f0fdfa,
                    #ffffff 52%,
                    #eff6ff
                );
        }

        .hero::before {
            content: "";
            position: absolute;

            width: 500px;
            height: 500px;

            right: -220px;
            top: -180px;

            border-radius: 50%;

            border: 80px solid rgba(20, 184, 166, 0.05);
        }

        .hero-inner {
            min-height: 650px;

            display: grid;
            grid-template-columns: 1.04fr 0.96fr;
            align-items: center;
            gap: 70px;

            padding: 80px 0;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            padding: 8px 13px;
            border-radius: 999px;

            background: white;
            border: 1px solid #d5f5ef;

            color: var(--primary);

            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1px;

            box-shadow:
                0 8px 25px rgba(15, 118, 110, 0.07);
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 0 5px #d1fae5;
        }

        .hero h1 {
            max-width: 680px;
            margin-top: 23px;

            font-size: clamp(46px, 5.5vw, 76px);
            line-height: 0.99;

            letter-spacing: -3.5px;
        }

        .hero h1 .accent {
            color: var(--primary);
        }

        .hero-description {
            max-width: 610px;
            margin-top: 25px;

            color: var(--muted);
            font-size: 18px;
            line-height: 1.75;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 13px;

            margin-top: 31px;
        }

        .btn {
            min-height: 50px;

            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;

            padding: 0 21px;

            border-radius: 13px;

            border: 1px solid transparent;

            font-weight: 800;
            font-size: 14px;

            cursor: pointer;
            transition: 0.2s;
        }

        .btn-primary {
            background: var(--primary);
            color: white;

            box-shadow:
                0 12px 28px rgba(15, 118, 110, 0.22);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .btn-outline {
            background: white;
            border-color: var(--border);
            color: var(--navy);
        }

        .btn-outline:hover {
            border-color: var(--primary);
            color: var(--primary);
            transform: translateY(-2px);
        }

        .hero-trust {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-top: 32px;
        }

        .trust-avatars {
            display: flex;
        }

        .trust-avatar {
            width: 34px;
            height: 34px;

            margin-left: -7px;

            border: 3px solid white;
            border-radius: 50%;

            display: grid;
            place-items: center;

            background: var(--primary-light);
            font-size: 16px;
        }

        .trust-avatar:first-child {
            margin-left: 0;
        }

        .trust-copy {
            color: var(--muted);
            font-size: 12px;
        }

        .trust-copy strong {
            display: block;
            color: var(--navy);
            font-size: 13px;
        }

        /* =========================================================
           HERO VISUAL
        ========================================================= */

        .hero-visual {
            position: relative;
            min-height: 510px;
        }

        .visual-main {
            position: absolute;
            inset: 25px 25px 25px 35px;

            overflow: hidden;

            border-radius: 34px;

            background:
                linear-gradient(
                    145deg,
                    #ccfbf1,
                    #ecfeff 48%,
                    #dbeafe
                );

            border: 1px solid rgba(255,255,255,0.9);

            box-shadow:
                0 35px 90px rgba(15, 23, 42, 0.12);
        }

        .visual-main::before {
            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            top: -100px;
            right: -90px;

            border-radius: 50%;

            background: rgba(255,255,255,0.35);
        }

        .visual-main::after {
            content: "";

            position: absolute;

            width: 230px;
            height: 230px;

            bottom: -90px;
            left: -70px;

            border-radius: 50%;

            border: 50px solid rgba(255,255,255,0.28);
        }

        .tooth {
            position: absolute;

            width: 220px;
            height: 285px;

            left: 50%;
            top: 50%;

            transform: translate(-50%, -50%);

            border-radius:
                48% 48% 43% 43%
                / 36% 36% 64% 64%;

            background:
                linear-gradient(
                    135deg,
                    #ffffff,
                    #f8fafc 55%,
                    #dbeafe
                );

            border: 7px solid rgba(255,255,255,0.75);

            box-shadow:
                inset -15px -18px 30px rgba(148, 163, 184, 0.14),
                0 35px 50px rgba(15, 118, 110, 0.14);

            display: grid;
            place-items: center;

            z-index: 2;
        }

        .tooth::before {
            content: "✦";

            font-size: 64px;

            color: #14b8a6;

            opacity: 0.8;
        }

        .tooth-shine {
            position: absolute;

            width: 28px;
            height: 55px;

            left: 45px;
            top: 48px;

            border-radius: 50%;

            background: rgba(255,255,255,0.9);

            transform: rotate(25deg);
        }

        .visual-label {
            position: absolute;
            z-index: 4;

            display: flex;
            align-items: center;
            gap: 10px;

            padding: 14px 17px;

            background: rgba(255,255,255,0.96);
            border: 1px solid rgba(226,232,240,0.9);

            border-radius: 16px;

            box-shadow:
                0 18px 40px rgba(15,23,42,0.10);

            font-size: 12px;
            font-weight: 800;
        }

        .visual-label-icon {
            width: 35px;
            height: 35px;

            border-radius: 11px;

            display: grid;
            place-items: center;

            background: var(--primary-light);
            color: var(--primary);

            font-size: 17px;
        }

        .label-top {
            top: 20px;
            left: 0;
        }

        .label-bottom {
            right: 0;
            bottom: 38px;
        }

        .mini-rating {
            position: absolute;
            z-index: 5;

            right: 30px;
            top: 70px;

            padding: 13px 16px;

            background: white;
            border-radius: 14px;

            box-shadow: var(--shadow);

            font-size: 12px;
            font-weight: 800;
        }

        .mini-rating-stars {
            color: #f59e0b;
            letter-spacing: 2px;
        }

        /* =========================================================
           STATS
        ========================================================= */

        .stats {
            background: white;
            border-bottom: 1px solid var(--border);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
        }

        .stat {
            padding: 29px 25px;
            text-align: center;

            border-right: 1px solid var(--border);
        }

        .stat:last-child {
            border-right: none;
        }

        .stat strong {
            display: block;
            font-size: 28px;
            letter-spacing: -1px;
            color: var(--navy);
        }

        .stat span {
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
        }

        /* =========================================================
           GENERAL SECTIONS
        ========================================================= */

        .section {
            padding: 100px 0;
        }

        .section-soft {
            background: #f1f5f9;
        }

        .section-heading {
            max-width: 700px;
            margin: 0 auto 55px;
            text-align: center;
        }

        .section-kicker {
            color: var(--primary);
            font-size: 12px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 1.6px;
        }

        .section-heading h2 {
            margin-top: 10px;

            font-size: clamp(34px, 4vw, 48px);
            line-height: 1.08;

            letter-spacing: -2px;
        }

        .section-heading p {
            margin-top: 16px;
            color: var(--muted);
            font-size: 16px;
        }

        /* =========================================================
           SERVICES
        ========================================================= */

        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .service-card {
            position: relative;
            overflow: hidden;

            padding: 29px;

            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);

            transition:
                transform 0.25s,
                box-shadow 0.25s,
                border-color 0.25s;
        }

        .service-card::after {
            content: "";

            position: absolute;

            width: 100px;
            height: 100px;

            right: -45px;
            bottom: -45px;

            border-radius: 50%;

            background: var(--primary-light);

            opacity: 0.6;
        }

        .service-card:hover {
            transform: translateY(-7px);

            border-color: #b2e8df;

            box-shadow:
                0 22px 50px rgba(15, 23, 42, 0.09);
        }

        .service-icon {
            width: 55px;
            height: 55px;

            display: grid;
            place-items: center;

            border-radius: 16px;

            background: var(--primary-light);
            color: var(--primary);

            font-size: 25px;
        }

        .service-card h3 {
            margin-top: 21px;
            font-size: 19px;
        }

        .service-card p {
            margin-top: 9px;

            color: var(--muted);
            font-size: 14px;
        }

        .service-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            margin-top: 19px;

            color: var(--primary);
            font-size: 13px;
            font-weight: 900;
        }

        /* =========================================================
           ABOUT
        ========================================================= */

        .about-grid {
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 70px;
            align-items: center;
        }

        .about-visual {
            min-height: 480px;

            position: relative;

            border-radius: 32px;

            background:
                linear-gradient(
                    145deg,
                    #0f766e,
                    #0d9488 55%,
                    #06b6d4
                );

            overflow: hidden;

            box-shadow:
                0 30px 70px rgba(15, 118, 110, 0.20);
        }

        .about-circle {
            position: absolute;

            width: 340px;
            height: 340px;

            border-radius: 50%;

            left: 50%;
            top: 50%;

            transform: translate(-50%, -50%);

            border: 55px solid rgba(255,255,255,0.12);
        }

        .about-icon {
            position: absolute;

            left: 50%;
            top: 50%;

            transform: translate(-50%, -50%);

            font-size: 105px;
            filter: drop-shadow(0 20px 20px rgba(0,0,0,0.12));
        }

        .about-badge {
            position: absolute;

            left: 25px;
            bottom: 25px;

            right: 25px;

            padding: 18px;

            background: rgba(255,255,255,0.13);
            border: 1px solid rgba(255,255,255,0.2);

            border-radius: 17px;

            color: white;

            backdrop-filter: blur(12px);
        }

        .about-badge strong {
            display: block;
            font-size: 16px;
        }

        .about-badge span {
            display: block;
            margin-top: 3px;

            color: #ccfbf1;
            font-size: 12px;
        }

        .about-content .section-kicker {
            display: block;
            margin-bottom: 10px;
        }

        .about-content h2 {
            font-size: clamp(34px, 4vw, 48px);
            line-height: 1.08;
            letter-spacing: -2px;
        }

        .about-content > p {
            margin-top: 19px;
            color: var(--muted);
        }

        .feature-list {
            display: grid;
            gap: 14px;
            margin-top: 27px;
        }

        .feature {
            display: flex;
            align-items: flex-start;
            gap: 13px;
        }

        .feature-check {
            width: 27px;
            height: 27px;
            flex-shrink: 0;

            display: grid;
            place-items: center;

            border-radius: 50%;

            background: var(--primary-light);
            color: var(--primary);

            font-size: 13px;
            font-weight: 900;
        }

        .feature strong {
            display: block;
            font-size: 14px;
        }

        .feature span {
            display: block;
            margin-top: 2px;
            color: var(--muted);
            font-size: 13px;
        }

        /* =========================================================
           DOCTORS
        ========================================================= */

        .doctors-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
            max-width: 850px;
            margin: 0 auto;
        }

        .doctor-card {
            display: flex;
            gap: 20px;
            align-items: center;

            padding: 25px;

            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);

            transition: 0.2s;
        }

        .doctor-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow);
        }

        .doctor-avatar {
            width: 100px;
            height: 100px;
            flex-shrink: 0;

            display: grid;
            place-items: center;

            border-radius: 27px;

            background:
                linear-gradient(
                    145deg,
                    #ccfbf1,
                    #dbeafe
                );

            font-size: 46px;
        }

        .doctor-card h3 {
            font-size: 19px;
        }

        .doctor-specialty {
            display: block;
            margin-top: 4px;

            color: var(--primary);
            font-size: 12px;
            font-weight: 800;
        }

        .doctor-card p {
            margin-top: 9px;
            color: var(--muted);
            font-size: 13px;
        }

        /* =========================================================
           PROCESS
        ========================================================= */

        .process-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .process-card {
            text-align: center;
            padding: 30px 24px;

            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }

        .process-number {
            width: 50px;
            height: 50px;

            margin: 0 auto;

            display: grid;
            place-items: center;

            border-radius: 50%;

            background: var(--primary);
            color: white;

            font-weight: 900;

            box-shadow:
                0 10px 22px rgba(15, 118, 110, 0.20);
        }

        .process-card h3 {
            margin-top: 18px;
            font-size: 18px;
        }

        .process-card p {
            margin-top: 8px;
            color: var(--muted);
            font-size: 13px;
        }

        /* =========================================================
           FAQ
        ========================================================= */

        .faq-list {
            max-width: 820px;
            margin: auto;

            display: grid;
            gap: 12px;
        }

        .faq-item {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;

            overflow: hidden;
        }

        .faq-question {
            width: 100%;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 19px 21px;

            background: white;
            border: none;

            color: var(--navy);

            text-align: left;

            font-size: 14px;
            font-weight: 800;

            cursor: pointer;
        }

        .faq-icon {
            color: var(--primary);
            font-size: 22px;

            transition: transform 0.2s;
        }

        .faq-answer {
            max-height: 0;
            overflow: hidden;

            transition:
                max-height 0.25s ease,
                padding 0.25s ease;

            padding: 0 21px;

            color: var(--muted);
            font-size: 13px;
        }

        .faq-item.open .faq-answer {
            max-height: 180px;
            padding: 0 21px 19px;
        }

        .faq-item.open .faq-icon {
            transform: rotate(45deg);
        }

        /* =========================================================
           BOOKING CTA
        ========================================================= */

        .booking-section {
            padding: 35px 0 100px;
        }

        .booking-box {
            position: relative;
            overflow: hidden;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;

            padding: 55px;

            border-radius: 30px;

            background:
                linear-gradient(
                    135deg,
                    #0f766e,
                    #0d9488 60%,
                    #06b6d4
                );

            color: white;

            box-shadow:
                0 30px 70px rgba(15, 118, 110, 0.20);
        }

        .booking-box::before {
            content: "";

            position: absolute;

            width: 330px;
            height: 330px;

            border-radius: 50%;

            right: -100px;
            top: -180px;

            border: 70px solid rgba(255,255,255,0.08);
        }

        .booking-content {
            position: relative;
            z-index: 2;
        }

        .booking-content span {
            color: #99f6e4;

            font-size: 11px;
            font-weight: 900;

            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .booking-content h2 {
            margin-top: 8px;

            font-size: clamp(29px, 4vw, 43px);
            line-height: 1.08;

            letter-spacing: -1.5px;
        }

        .booking-content p {
            max-width: 600px;
            margin-top: 10px;

            color: #ccfbf1;
            font-size: 14px;
        }

        .booking-box .btn {
            position: relative;
            z-index: 2;

            background: white;
            color: var(--primary);

            flex-shrink: 0;
        }

        .booking-box .btn:hover {
            transform: translateY(-2px);
            background: #f8fafc;
        }

        /* =========================================================
           CONTACT
        ========================================================= */

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .contact-card {
            padding: 27px;

            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius);
        }

        .contact-icon {
            width: 48px;
            height: 48px;

            display: grid;
            place-items: center;

            border-radius: 14px;

            background: var(--primary-light);
