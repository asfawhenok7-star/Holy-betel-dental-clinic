<script>
(function () {

    const API_URL = 'http://localhost:5000/api/assistant';

    window.bsToggleAssistant = function () {
        const chat = document.getElementById('bsAiChat');
        const input = document.getElementById('bsAiInput');

        if (!chat) return;

        chat.classList.toggle('open');

        if (chat.classList.contains('open')) {
            setTimeout(() => {
                if (input) input.focus();
            }, 150);
        }
    };

    window.bsAskQuick = function (message) {
        const input = document.getElementById('bsAiInput');

        if (input) {
            input.value = message;
        }

        bsSendMessage();
    };

    function addMessage(type, text, action) {
        const messages = document.getElementById('bsAiMessages');

        if (!messages) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'bs-ai-message ' + type;

        const bubble = document.createElement('div');
        bubble.className = 'bs-ai-bubble';

        bubble.textContent = text;

        wrapper.appendChild(bubble);

        if (type === 'assistant' && action === 'book') {
            const actionDiv = document.createElement('div');
            actionDiv.className = 'bs-ai-action';

            const bookButton = document.createElement('button');
            bookButton.type = 'button';
            bookButton.className = 'bs-ai-book-button';
            bookButton.textContent = '📅 Book an Appointment';

            bookButton.onclick = function () {
                window.location.href = 'booking.html';
            };

            actionDiv.appendChild(bookButton);
            bubble.appendChild(actionDiv);
        }

        messages.appendChild(wrapper);

        messages.scrollTop = messages.scrollHeight;
    }

    function showTyping() {
        const messages = document.getElementById('bsAiMessages');

        if (!messages) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'bs-ai-message assistant';
        wrapper.id = 'bsAiTypingMessage';

        const bubble = document.createElement('div');
        bubble.className = 'bs-ai-bubble';

        const typing = document.createElement('div');
        typing.className = 'bs-ai-typing';

        typing.innerHTML =
            '<span></span>' +
            '<span></span>' +
            '<span></span>';

        bubble.appendChild(typing);
        wrapper.appendChild(bubble);
        messages.appendChild(wrapper);

        messages.scrollTop = messages.scrollHeight;
    }

    function hideTyping() {
        const typing = document.getElementById('bsAiTypingMessage');

        if (typing) {
            typing.remove();
        }
    }

    window.bsSendMessage = async function () {
        const input = document.getElementById('bsAiInput');

        if (!input) return;

        const message = input.value.trim();

        if (!message) return;

        addMessage('user', message);

        input.value = '';

        showTyping();

        try {
            const response = await fetch(API_URL, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    message: message
                })
            });

            const result = await response.json();

            hideTyping();

            if (!response.ok || !result.success) {
                addMessage(
                    'assistant',
                    result.message ||
                    'Sorry, I could not process your question right now.'
                );

                return;
            }

            addMessage(
                'assistant',
                result.answer,
                result.action
            );

        } catch (error) {
            console.error('BrightSmile AI error:', error);

            hideTyping();

            addMessage(
                'assistant',
                'I cannot connect to the dental assistant right now. Please try again or use the appointment page.'
            );
        }
    };

    document.addEventListener('DOMContentLoaded', function () {
        const input = document.getElementById('bsAiInput');

        if (input) {
            input.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    bsSendMessage();
                }
            });
        }
    });

})();
</script>
